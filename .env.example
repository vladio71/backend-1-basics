# Порт, на якому слухає застосунок
PORT=3000

# Підключення до PostgreSQL
# PG_PORT: порт на хості для Docker (його сам пише npm run up у .env, якщо 5432 зайнятий).
# DB_PORT: порт, до якого підключається застосунок (seed, міграції, e2e). Якщо DB_PORT = 5432,
# а PG_PORT задано, застосунок бере PG_PORT, тож міняти DB_PORT вручну не треба.
DB_HOST=localhost
DB_PORT=5432
DB_USER=library
DB_PASSWORD=library
DB_NAME=library

# База для e2e-тестів (npm run test:e2e). Тести чистять її таблиці, тому це окрема база,
# не DB_NAME. Назва має закінчуватись на _test. Якщо її немає, тести створять її самі
# (потрібне право CREATEDB), інакше створи вручну: CREATE DATABASE library_test;
DB_NAME_TEST=library_test
