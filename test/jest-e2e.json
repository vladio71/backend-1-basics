{
  "rootDir": "..",
  "testRegex": "test/.*\\.e2e-spec\\.ts$",
  "moduleFileExtensions": ["js", "json", "ts"],
  "transform": {
    "^.+\\.ts$": "ts-jest"
  },
  "testEnvironment": "node",
  "testTimeout": 30000,
  "globalSetup": "<rootDir>/test/e2e-global-setup.ts",
  "setupFiles": ["<rootDir>/test/e2e-env.ts"]
}
