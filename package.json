{
  "name": "library-basics",
  "version": "1.0.0",
  "description": "Навчальний бекенд: бібліотека на NestJS + PostgreSQL",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "up": "node scripts/up.mjs",
    "down": "node scripts/down.mjs",
    "build": "nest build && npm run build:scheme",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/database/data-source.ts -p src/database/migrations/Migration",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "seed": "ts-node src/database/seed.ts",
    "deps:check": "depcruise src --config .dependency-cruiser.cjs",
    "graph": "depcruise src --config .dependency-cruiser.cjs --output-type archi --include-only \"^src\" | dot -Tsvg -o docs/graphs/modules.svg",
    "graph:files": "depcruise src --config .dependency-cruiser.cjs --output-type dot --include-only \"^src\" | dot -Tsvg -o docs/graphs/files.svg",
    "docs:code": "compodoc -p tsconfig.build.json -d docs/compodoc -n \"library-basics\" --disableCoverage --disableDomTree --disableTemplateTab --disableStyleTab",
    "test": "jest",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand",
    "build:scheme": "node scheme/build.mjs"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/typeorm": "11.0.3",
    "@scalar/nestjs-api-reference": "1.2.33",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "17.2.3",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@compodoc/compodoc": "2.0.0",
    "@excalidraw/excalidraw": "^0.18.1",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.8",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/supertest": "7.2.1",
    "dependency-cruiser": "18.7.0",
    "esbuild": "^0.28.2",
    "jest": "30.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "jest": {
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
